{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWatch Source Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "name",
      "category",
      "canonical_url",
      "license",
      "cadence",
      "owner",
      "sensitivity",
      "parser",
      "freshness_sla",
      "validation_rules",
      "confidence_model",
      "priority_tier",
      "legal_notes"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 3
      },
      "category": {
        "type": "string",
        "enum": [
          "public-geospatial",
          "public-program",
          "public-fuel-cycle",
          "public-reactor",
          "public-infrastructure",
          "public-policy",
          "public-grid",
          "public-tech",
          "public-industry",
          "internal-document"
        ]
      },
      "canonical_url": {
        "type": "string",
        "minLength": 5
      },
      "license": {
        "type": "string",
        "minLength": 3
      },
      "cadence": {
        "type": "string",
        "minLength": 3
      },
      "owner": {
        "type": "string",
        "minLength": 3
      },
      "sensitivity": {
        "type": "string",
        "enum": ["public", "internal", "confidential", "restricted"]
      },
      "parser": {
        "type": "string",
        "minLength": 3
      },
      "freshness_sla": {
        "type": "string",
        "minLength": 4
      },
      "validation_rules": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 3 }
      },
      "confidence_model": {
        "type": "string",
        "minLength": 8
      },
      "priority_tier": {
        "type": "string",
        "enum": ["P0", "P1", "P2"]
      },
      "legal_notes": {
        "type": "string",
        "minLength": 8
      }
    },
    "additionalProperties": false
  }
}
